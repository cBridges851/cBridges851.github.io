{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "ask",
      ".github/workflows/*": "deny",
      "lighthouserc.json": "deny"
    },
    "bash": {
      "*": "ask",
      "dotnet build *": "allow",
      "dotnet test *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "dotnet add package *": "ask",
      "git push *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  }
}