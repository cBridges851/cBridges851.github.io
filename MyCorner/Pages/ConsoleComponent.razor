@using System.Net
@using MyCorner.Locations
@using MyCorner.Commands
@inject IJSRuntime js;

<div class="console-component">
    <header>
        <h1>@this.CurrentLocation.Name</h1>
    </header>

    <form @onsubmit="HandleSubmit" @onsubmit:preventDefault>
        <div class="console-component__output">
            <h2>
                cBridges.github.io, A Personal Website by Christa Bridges
                v2.0.0
            </h2>
            @foreach (var output in this.ConsoleOutput) {
                if (output.isHeader) {
                    <h3>@output.output</h3>
                } else {
                    <div class="console-component__output-item">@output.output</div>
                }
            }
        </div>
        <div class="console-component__input">
            <span>&gt;</span>
            <input name="command-input" type="text" title="Command Input" placeholder="Enter command..." @bind="this.CurrentInput"/>
            <input type="submit" value="GO"/>
        </div>
    </form>
</div>

<script>
    function scrollToLatestItem() {
        const outputContainer = document.getElementsByClassName("console-component__output")[0];
        if (outputContainer === null) {
            return;
        }
        outputContainer.scrollTop = outputContainer.scrollHeight;
    }
</script>

@code {
    private record OutputItem(MarkupString output, bool isHeader);
    private Location CurrentLocation;
    private List<OutputItem> ConsoleOutput = new() { };
    private string CurrentInput = "";

    protected override void OnInitialized() {
        this.CurrentLocation = new TARDISConsoleRoom(js);
        this.ConsoleOutput.Add(new OutputItem((MarkupString)this.CurrentLocation.Name, true));
        this.ConsoleOutput.Add(new OutputItem((MarkupString)this.CurrentLocation.Description, false));
    }

    private async Task HandleSubmit() {
        await this.ProcessInput();
        await Task.Yield();
        await js.InvokeVoidAsync("scrollToLatestItem");
    }

    private async Task ProcessInput() {
        var cleansedUserInput = WebUtility.HtmlEncode($"> {this.CurrentInput.Trim()}");
        this.ConsoleOutput.Add(new OutputItem((MarkupString)cleansedUserInput, false));

        var parts = this.CurrentInput.Trim().Split(' ', 2);
        var verb = parts[0];
        var args = parts.Length > 1 ? parts[1].Split(' ') : Array.Empty<string>();

        var result = await this.CurrentLocation.ExecuteAction(verb, args);
        this.ConsoleOutput.Add(new OutputItem((MarkupString)result.Message, false));

        if (result.NewLocation != null) {
            this.CurrentLocation = result.NewLocation;
            this.ConsoleOutput.Add(new OutputItem((MarkupString)this.CurrentLocation.Name, true));
            this.ConsoleOutput.Add(new OutputItem((MarkupString)this.CurrentLocation.Description, false));
        }

        this.CurrentInput = "";
    }
}